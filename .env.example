PUBLIC_URL=https://stream.example.com
PORT=8080
NODE_ENV=production

# STUN e opcional: sem a variavel o servidor usa os STUN publicos do Google.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN e obrigatorio para quem assiste atras de NAT simetrico ou CGNAT (4G/5G, rede
# corporativa). Sem as tres variaveis preenchidas o servidor sobe so com STUN e avisa
# no log. Aceita varios enderecos separados por virgula na mesma credencial.
TURN_URLS=turn:turn.example.com:3478,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349
TURN_USERNAME=replace-with-turn-username
TURN_CREDENTIAL=replace-with-turn-credential
